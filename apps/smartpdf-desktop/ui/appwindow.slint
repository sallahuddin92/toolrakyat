// SmartPDF Slint UI Specification
// Acrobat Pro-Class Desktop Workspace & Design System
// Built for high-performance, precision document engineering matching SmartPDF Design Brief

import { ScrollView } from "std-widgets.slint";

export struct TabItem {
    id: string,
    title: string,
    is_active: bool,
    is_dirty: bool,
}

export struct PageThumbnail {
    page_index: int,
    label: string,
    dimensions: string,
    is_active: bool,
}

export struct TextSpanData {
    id: string,
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    font_size: length,
    font_family: string,
    color_hex: string,
    is_selected: bool,
}

export struct ElementItem {
    id: string,
    kind: string,
    x: length,
    y: length,
    width: length,
    height: length,
    label: string,
    is_selected: bool,
}

export component AppWindow inherits Window {
    title: "✦ SmartPDF Pro — Precision Document Engineering";
    preferred-width: 1320px;
    preferred-height: 840px;
    min-width: 980px;
    min-height: 620px;
    background: root.is_dark_mode ? #0B1120 : #F1F5F9;

    // ==========================================
    // Properties Bound from Rust Application Core
    // ==========================================
    in-out property <[TabItem]> tabs: [
        { id: "tab-1", title: "sample_contract.pdf", is_active: true, is_dirty: false },
    ];
    in-out property <string> active_tab_id: "tab-1";
    in-out property <string> active_tool: "select"; // "select", "text", "annotate", "forms", "pages"
    
    in-out property <[PageThumbnail]> thumbnails: [
        { page_index: 0, label: "Page 1", dimensions: "612 × 792 pt", is_active: true },
        { page_index: 1, label: "Page 2", dimensions: "612 × 792 pt", is_active: false },
    ];
    in-out property <int> active_page: 0;
    in-out property <int> total_pages: 2;
    in-out property <string> page_info_text: "Page 1 of 2";

    // Viewport & Zoom
    in-out property <float> zoom_scale: 1.0;
    in-out property <int> zoom_percent: 100;
    in-out property <length> page_width: 612px;
    in-out property <length> page_height: 792px;
    in-out property <image> rendered_page_image;
    in-out property <bool> has_rendered_page_image: false;
    in-out property <bool> gpu_acceleration_enabled: true;
    in-out property <string> render_engine_badge: "GPU (Metal)";
    in-out property <string> gpu_metrics_detail: "GPU: ready";
    callback toggle_gpu_acceleration();

    // Active Page Extracted Elements
    in-out property <[TextSpanData]> text_spans: [];
    in-out property <[ElementItem]> page_elements: [];

    // Selection State
    in-out property <bool> has_selection: false;
    in-out property <string> selection_type: "None";
    in-out property <string> selection_node_id: "";
    in-out property <string> selection_bounds_text: "";
    in-out property <string> selection_font_name: "";
    in-out property <string> selection_font_size: "";
    in-out property <string> selection_text_content: "";
    in-out property <bool> selection_is_editable: false;
    in-out property <length> sel_x: 0px;
    in-out property <length> sel_y: 0px;
    in-out property <length> sel_w: 0px;
    in-out property <length> sel_h: 0px;

    // In-place text editing
    in-out property <bool> is_editing_text: false;
    in-out property <string> editing_text_buffer: "";

    // Status & Security
    in-out property <string> evidence_level: "VERIFIED";
    in-out property <string> security_status: "Unrestricted (Local-First)";
    in-out property <int> undo_depth: 0;
    in-out property <int> redo_depth: 0;
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;

    // Panel Toggles
    in-out property <bool> left_panel_visible: true;
    in-out property <bool> right_panel_visible: true;

    // Toast / Feedback message
    in-out property <string> status_message: "Ready";

    // Form field & Annotation properties
    in-out property <string> form_field_name: "";
    in-out property <string> form_field_type: ""; // "Text", "Checkbox", "Choice", "Radio"
    in-out property <string> form_field_value: "";
    in-out property <bool> form_field_checked: false;
    in-out property <string> annotation_subtype: ""; // "Highlight", "FreeText", "Square"

    // Acrobat-Class UI Extensions
    in-out property <bool> is_dark_mode: false; // Professional Light Theme as Default
    in-out property <string> left_rail_tab: "pages"; // "pages", "tools", "bookmarks"
    in-out property <string> tools_search_query: "";

    // ==========================================
    // Callbacks to Rust Application Core
    // ==========================================
    callback open_file_clicked();
    callback export_document_clicked();
    callback tab_selected(string);
    callback tab_closed(string);
    callback tool_changed(string);
    callback page_selected(int);
    callback prev_page_clicked();
    callback next_page_clicked();
    callback zoom_in_clicked();
    callback zoom_out_clicked();
    callback zoom_reset_clicked();
    callback fit_width_clicked();
    callback undo_clicked();
    callback redo_clicked();
    callback toggle_left_panel();
    callback toggle_right_panel();
    callback toggle_theme();
    callback left_rail_tab_selected(string);
    callback span_selected(string);
    callback element_selected(string);
    callback canvas_background_clicked();
    callback text_edit_committed(string);
    callback property_text_edited(string);
    callback save_document_clicked();
    callback delete_selected_clicked();
    callback add_annotation_clicked(string);
    callback update_annotation_text_clicked(string);
    callback add_image_clicked();
    callback replace_image_clicked();
    callback move_selected_clicked(float, float);
    callback resize_selected_clicked(float, float);
    callback form_field_toggled(string, string);
    callback form_field_text_committed(string, string);
    callback insert_blank_page_clicked();
    callback duplicate_page_clicked();
    callback move_page_up_clicked();
    callback move_page_down_clicked();
    callback delete_page_clicked();

    // Keyboard shortcut handler
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.meta || event.modifiers.control) {
                if (event.text == "o" || event.text == "O") {
                    root.open_file_clicked();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.save_document_clicked();
                    return accept;
                }
                if (event.text == "z" || event.text == "Z") {
                    if (event.modifiers.shift) {
                        root.redo_clicked();
                    } else {
                        root.undo_clicked();
                    }
                    return accept;
                }
                if (event.text == "y" || event.text == "Y") {
                    root.redo_clicked();
                    return accept;
                }
                if (event.text == "0") {
                    root.zoom_reset_clicked();
                    return accept;
                }
                if (event.text == "1") {
                    root.fit_width_clicked();
                    return accept;
                }
                if (event.text == "=" || event.text == "+") {
                    root.zoom_in_clicked();
                    return accept;
                }
                if (event.text == "-") {
                    root.zoom_out_clicked();
                    return accept;
                }
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                root.delete_selected_clicked();
                return accept;
            }
            if (root.has_selection && !root.is_editing_text) {
                if (event.text == Key.LeftArrow) {
                    root.move_selected_clicked(-10.0, 0.0);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.move_selected_clicked(10.0, 0.0);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move_selected_clicked(0.0, -10.0);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move_selected_clicked(0.0, 10.0);
                    return accept;
                }
            }
            if (event.text == Key.PageUp) {
                root.prev_page_clicked();
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.next_page_clicked();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ====================================================================
        // 1. TOP GLOBAL APPLICATION CHROME (Acrobat-Class 2-Tier Header)
        // ====================================================================
        Rectangle {
            height: 84px;
            background: root.is_dark_mode ? #1E293B : #FFFFFF;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // ------------------------------------------------------------
                // 1A. Top Tab Rail: Branding + Document Tabs + Global Tools
                // ------------------------------------------------------------
                Rectangle {
                    height: 42px;
                    background: root.is_dark_mode ? #151F2E : #F8FAFC;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: center;

                        // SmartPDF Pro Branding
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: "✦";
                                font-size: 17px;
                                font-weight: 800;
                                color: #0EA5E9; // Sky 500
                                vertical-alignment: center;
                            }
                            Text {
                                text: "SmartPDF";
                                font-size: 14px;
                                font-weight: 700;
                                color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 28px;
                                height: 16px;
                                border-radius: 3px;
                                background: #0EA5E922;
                                Text {
                                    text: "PRO";
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: #0EA5E9;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Separator
                        Rectangle {
                            width: 1px;
                            height: 20px;
                            background: root.is_dark_mode ? #334155 : #E2E8F0;
                        }

                        // Document Tabs Container
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;

                            for tab in root.tabs : Rectangle {
                                min-width: 130px;
                                max-width: 210px;
                                height: 32px;
                                background: tab.is_active ? (root.is_dark_mode ? #1E293B : #FFFFFF) : (root.is_dark_mode ? #0F172A : #F1F5F9);
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: tab.is_active ? #0EA5E9 : (root.is_dark_mode ? #334155 : #E2E8F0);

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: "📄";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: tab.is_dirty ? tab.title + " *" : tab.title;
                                        font-size: 12px;
                                        font-weight: tab.is_active ? 600 : 500;
                                        color: tab.is_active ? (root.is_dark_mode ? #F8FAFC : #0F172A) : (root.is_dark_mode ? #94A3B8 : #64748B);
                                        overflow: elide;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }

                                    // Close Tab Button
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 9px;
                                        background: close-ta.has-hover ? #EF4444 : transparent;

                                        Text {
                                            text: "×";
                                            font-size: 14px;
                                            color: close-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #64748B : #94A3B8);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        close-ta := TouchArea {
                                            clicked => {
                                                root.tab_closed(tab.id);
                                            }
                                        }
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        root.tab_selected(tab.id);
                                    }
                                }
                            }

                            // Add New Document / Open Button [+]
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: add-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.is_dark_mode ? #1E293B : #F1F5F9);
                                border-width: 1px;
                                border-color: root.is_dark_mode ? #475569 : #CBD5E1;

                                Text {
                                    text: "+";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: #0EA5E9;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                add-ta := TouchArea {
                                    clicked => {
                                        root.open_file_clicked();
                                    }
                                }
                            }
                        }

                        // Flexible space to right controls
                        Rectangle { horizontal-stretch: 1; }

                        // Theme Switcher (Light / Dark)
                        Rectangle {
                            height: 28px;
                            border-radius: 5px;
                            background: theme-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.is_dark_mode ? #1E293B : #F1F5F9);
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #475569 : #CBD5E1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: root.is_dark_mode ? "🌙 Dark" : "☀️ Light";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                    vertical-alignment: center;
                                }
                            }

                            theme-ta := TouchArea {
                                clicked => {
                                    root.is_dark_mode = !root.is_dark_mode;
                                    root.toggle_theme();
                                }
                            }
                        }

                        // GPU Acceleration Badge/Toggle
                        Rectangle {
                            height: 28px;
                            border-radius: 5px;
                            background: gpu-btn-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.gpu_acceleration_enabled ? (root.is_dark_mode ? #0369A1 : #E0F2FE) : (root.is_dark_mode ? #1E293B : #F1F5F9));
                            border-width: 1px;
                            border-color: root.gpu_acceleration_enabled ? #0EA5E9 : (root.is_dark_mode ? #475569 : #CBD5E1);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: "⚡ " + root.render_engine_badge;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.gpu_acceleration_enabled ? (root.is_dark_mode ? #FFFFFF : #0284C7) : (root.is_dark_mode ? #94A3B8 : #64748B);
                                    vertical-alignment: center;
                                }
                            }
                            gpu-btn-ta := TouchArea {
                                clicked => { root.toggle_gpu_acceleration(); }
                            }
                        }

                        // Left Navigation Panel Toggle
                        Rectangle {
                            width: 32px;
                            height: 28px;
                            border-radius: 5px;
                            background: lp-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.left_panel_visible ? (root.is_dark_mode ? #0284C7 : #0EA5E9) : (root.is_dark_mode ? #1E293B : #F1F5F9));
                            border-width: 1px;
                            border-color: root.left_panel_visible ? #0EA5E9 : (root.is_dark_mode ? #475569 : #CBD5E1);

                            Text {
                                text: "◨";
                                font-size: 14px;
                                color: root.left_panel_visible ? #FFFFFF : (root.is_dark_mode ? #94A3B8 : #64748B);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            lp-ta := TouchArea {
                                clicked => { root.toggle_left_panel(); }
                            }
                        }

                        // Right Properties Panel Toggle
                        Rectangle {
                            width: 32px;
                            height: 28px;
                            border-radius: 5px;
                            background: rp-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.right_panel_visible ? (root.is_dark_mode ? #0284C7 : #0EA5E9) : (root.is_dark_mode ? #1E293B : #F1F5F9));
                            border-width: 1px;
                            border-color: root.right_panel_visible ? #0EA5E9 : (root.is_dark_mode ? #475569 : #CBD5E1);

                            Text {
                                text: "◧";
                                font-size: 14px;
                                color: root.right_panel_visible ? #FFFFFF : (root.is_dark_mode ? #94A3B8 : #64748B);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            rp-ta := TouchArea {
                                clicked => { root.toggle_right_panel(); }
                            }
                        }
                    }
                }

                // Header Divider
                Rectangle {
                    height: 1px;
                    background: root.is_dark_mode ? #334155 : #E2E8F0;
                }

                // ------------------------------------------------------------
                // 1B. Acrobat-Class Mode Navigation & Workflow Action Bar
                // ------------------------------------------------------------
                Rectangle {
                    height: 41px;
                    background: root.is_dark_mode ? #1E293B : #FFFFFF;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        // Open Document
                        Rectangle {
                            width: 96px;
                            height: 28px;
                            border-radius: 5px;
                            background: open-btn-ta.has-hover ? #0284C7 : #0EA5E9;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text {
                                    text: "📂 Open";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }

                            open-btn-ta := TouchArea {
                                clicked => {
                                    root.open_file_clicked();
                                }
                            }
                        }

                        Rectangle { width: 1px; height: 18px; background: root.is_dark_mode ? #334155 : #E2E8F0; }

                        // Acrobat Workflow Categories
                        HorizontalLayout {
                            spacing: 4px;

                            // All Tools
                            Rectangle {
                                width: 88px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.left_rail_tab == "tools" && root.left_panel_visible ? (root.is_dark_mode ? #0369A1 : #E0F2FE) : (t-all-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                                border-width: root.left_rail_tab == "tools" && root.left_panel_visible ? 1px : 0px;
                                border-color: #0EA5E9;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "🗂 All Tools";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.left_rail_tab == "tools" && root.left_panel_visible ? (root.is_dark_mode ? #FFFFFF : #0284C7) : (root.is_dark_mode ? #CBD5E1 : #334155);
                                        vertical-alignment: center;
                                    }
                                }

                                t-all-ta := TouchArea {
                                    clicked => {
                                        root.left_rail_tab = "tools";
                                        root.left_panel_visible = true;
                                        root.left_rail_tab_selected("tools");
                                    }
                                }
                            }

                            // Edit PDF
                            Rectangle {
                                width: 78px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.active_tool == "text" ? #0EA5E9 : (t-edit-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "✎ Edit";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.active_tool == "text" ? #FFFFFF : (root.is_dark_mode ? #CBD5E1 : #334155);
                                        vertical-alignment: center;
                                    }
                                }

                                t-edit-ta := TouchArea {
                                    clicked => {
                                        root.tool_changed("text");
                                    }
                                }
                            }

                            // Organize Pages
                            Rectangle {
                                width: 92px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.active_tool == "pages" ? #0EA5E9 : (t-org-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "☷ Organize";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.active_tool == "pages" ? #FFFFFF : (root.is_dark_mode ? #CBD5E1 : #334155);
                                        vertical-alignment: center;
                                    }
                                }

                                t-org-ta := TouchArea {
                                    clicked => {
                                        root.tool_changed("pages");
                                        root.left_rail_tab = "pages";
                                        root.left_panel_visible = true;
                                    }
                                }
                            }

                            // Forms & Fill
                            Rectangle {
                                width: 78px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.active_tool == "forms" ? #0EA5E9 : (t-frm-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "☑ Forms";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.active_tool == "forms" ? #FFFFFF : (root.is_dark_mode ? #CBD5E1 : #334155);
                                        vertical-alignment: center;
                                    }
                                }

                                t-frm-ta := TouchArea {
                                    clicked => {
                                        root.tool_changed("forms");
                                    }
                                }
                            }

                            // Annotate & Review
                            Rectangle {
                                width: 92px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.active_tool == "annotate" ? #0EA5E9 : (t-ann-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "✎ Annotate";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.active_tool == "annotate" ? #FFFFFF : (root.is_dark_mode ? #CBD5E1 : #334155);
                                        vertical-alignment: center;
                                    }
                                }

                                t-ann-ta := TouchArea {
                                    clicked => {
                                        root.tool_changed("annotate");
                                    }
                                }
                            }
                        }

                        Rectangle { width: 1px; height: 18px; background: root.is_dark_mode ? #334155 : #E2E8F0; }

                        // History Undo / Redo
                        Rectangle {
                            width: 32px;
                            height: 28px;
                            border-radius: 4px;
                            background: undo-ta.has-hover && root.can_undo ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                            Text {
                                text: "↩";
                                font-size: 15px;
                                color: root.can_undo ? (root.is_dark_mode ? #F8FAFC : #0F172A) : (root.is_dark_mode ? #475569 : #CBD5E1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            undo-ta := TouchArea {
                                clicked => { if (root.can_undo) { root.undo_clicked(); } }
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 28px;
                            border-radius: 4px;
                            background: redo-ta.has-hover && root.can_redo ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                            Text {
                                text: "↪";
                                font-size: 15px;
                                color: root.can_redo ? (root.is_dark_mode ? #F8FAFC : #0F172A) : (root.is_dark_mode ? #475569 : #CBD5E1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            redo-ta := TouchArea {
                                clicked => { if (root.can_redo) { root.redo_clicked(); } }
                            }
                        }

                        // Right-aligned global actions
                        Rectangle { horizontal-stretch: 1; }

                        // Save Document
                        Rectangle {
                            width: 76px;
                            height: 28px;
                            border-radius: 5px;
                            background: sav-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : (root.is_dark_mode ? #1E293B : #F8FAFC);
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #475569 : #CBD5E1;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "🖫 Save";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                    vertical-alignment: center;
                                }
                            }
                            sav-ta := TouchArea {
                                clicked => { root.save_document_clicked(); }
                            }
                        }

                        // Export Button (Primary Accent)
                        Rectangle {
                            width: 96px;
                            height: 28px;
                            border-radius: 5px;
                            background: exp-ta.has-hover ? #0284C7 : #0EA5E9;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "💾 Export ▾";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                            exp-ta := TouchArea {
                                clicked => { root.export_document_clicked(); }
                            }
                        }
                    }
                }

                // Chrome Bottom Border
                Rectangle {
                    height: 1px;
                    background: root.is_dark_mode ? #334155 : #CBD5E1;
                }
            }
        }

        // ====================================================================
        // 2. MAIN THREE-PANEL WORKSPACE (Left Nav + Central Viewport + Right Props)
        // ====================================================================
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ----------------------------------------------------------------
            // 2A. LEFT NAVIGATION RAIL (Acrobat-Style Navigation ~240px)
            // ----------------------------------------------------------------
            if root.left_panel_visible : HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    width: 240px;
                    background: root.is_dark_mode ? #151F2E : #F8FAFC;

                    VerticalLayout {
                        spacing: 0px;
                        padding: 0px;

                        // Left Rail Mode Tabs Header (Pages, All Tools, Bookmarks)
                        Rectangle {
                            height: 38px;
                            background: root.is_dark_mode ? #1E293B : #F1F5F9;

                            HorizontalLayout {
                                spacing: 2px;
                                padding: 3px;

                                // Pages Tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.left_rail_tab == "pages" ? (root.is_dark_mode ? #0F172A : #FFFFFF) : transparent;
                                    border-width: root.left_rail_tab == "pages" ? 1px : 0px;
                                    border-color: root.is_dark_mode ? #334155 : #CBD5E1;

                                    Text {
                                        text: "☷ Pages";
                                        font-size: 11px;
                                        font-weight: root.left_rail_tab == "pages" ? 700 : 500;
                                        color: root.left_rail_tab == "pages" ? #0EA5E9 : (root.is_dark_mode ? #94A3B8 : #64748B);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.left_rail_tab = "pages";
                                            root.left_rail_tab_selected("pages");
                                        }
                                    }
                                }

                                // All Tools Tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.left_rail_tab == "tools" ? (root.is_dark_mode ? #0F172A : #FFFFFF) : transparent;
                                    border-width: root.left_rail_tab == "tools" ? 1px : 0px;
                                    border-color: root.is_dark_mode ? #334155 : #CBD5E1;

                                    Text {
                                        text: "🗂 Tools";
                                        font-size: 11px;
                                        font-weight: root.left_rail_tab == "tools" ? 700 : 500;
                                        color: root.left_rail_tab == "tools" ? #0EA5E9 : (root.is_dark_mode ? #94A3B8 : #64748B);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.left_rail_tab = "tools";
                                            root.left_rail_tab_selected("tools");
                                        }
                                    }
                                }

                                // Bookmarks Tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.left_rail_tab == "bookmarks" ? (root.is_dark_mode ? #0F172A : #FFFFFF) : transparent;
                                    border-width: root.left_rail_tab == "bookmarks" ? 1px : 0px;
                                    border-color: root.is_dark_mode ? #334155 : #CBD5E1;

                                    Text {
                                        text: "🔖 Outline";
                                        font-size: 11px;
                                        font-weight: root.left_rail_tab == "bookmarks" ? 700 : 500;
                                        color: root.left_rail_tab == "bookmarks" ? #0EA5E9 : (root.is_dark_mode ? #94A3B8 : #64748B);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.left_rail_tab = "bookmarks";
                                            root.left_rail_tab_selected("bookmarks");
                                        }
                                    }
                                }
                            }
                        }

                        // Sub-header Divider
                        Rectangle {
                            height: 1px;
                            background: root.is_dark_mode ? #334155 : #E2E8F0;
                        }

                        // Content Area Based on Mode Tab
                        // 1. Pages Thumbnails Mode
                        if root.left_rail_tab == "pages" : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            padding: 10px;

                            // Page Action Header
                            Rectangle {
                                height: 28px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "PAGES (" + root.total_pages + ")";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.is_dark_mode ? #94A3B8 : #64748B;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        // Insert Blank
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: b-btn.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text { text: "+"; font-size: 13px; font-weight: 700; color: b-btn.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                            b-btn := TouchArea { clicked => { root.insert_blank_page_clicked(); } }
                                        }
                                        // Duplicate
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: d-btn.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text { text: "⧉"; font-size: 11px; color: d-btn.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                            d-btn := TouchArea { clicked => { root.duplicate_page_clicked(); } }
                                        }
                                        // Move Up
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: u-btn.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text { text: "▲"; font-size: 9px; color: u-btn.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                            u-btn := TouchArea { clicked => { root.move_page_up_clicked(); } }
                                        }
                                        // Move Down
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: dn-btn.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text { text: "▼"; font-size: 9px; color: dn-btn.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                            dn-btn := TouchArea { clicked => { root.move_page_down_clicked(); } }
                                        }
                                        // Delete Page
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: del-btn.has-hover ? #EF4444 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text { text: "🗑"; font-size: 10px; color: del-btn.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                            del-btn := TouchArea { clicked => { root.delete_page_clicked(); } }
                                        }
                                    }
                                }
                            }

                            // Thumbnails Scrollable List
                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-right: 4px;

                                    for thumb in root.thumbnails : Rectangle {
                                        height: 110px;
                                        background: thumb.is_active ? (root.is_dark_mode ? #0F172A : #FFFFFF) : (root.is_dark_mode ? #1E293B : #F1F5F9);
                                        border-radius: 6px;
                                        border-width: thumb.is_active ? 2px : 1px;
                                        border-color: thumb.is_active ? #0EA5E9 : (root.is_dark_mode ? #334155 : #E2E8F0);

                                        VerticalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            // Thumbnail preview box (Paper silhouette with authentic document proportions)
                                            Rectangle {
                                                width: 56px;
                                                height: 78px;
                                                background: #FFFFFF;
                                                border-radius: 2px;
                                                border-width: 1px;
                                                border-color: #CBD5E1;
                                                drop-shadow-blur: 4px;

                                                Text {
                                                    text: thumb.label;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: #64748B;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: thumb.label + " (" + thumb.dimensions + ")";
                                                font-size: 10px;
                                                color: thumb.is_active ? (root.is_dark_mode ? #F8FAFC : #0F172A) : (root.is_dark_mode ? #94A3B8 : #64748B);
                                                horizontal-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.page_selected(thumb.page_index);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. All Tools Catalog Mode
                        if root.left_rail_tab == "tools" : ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 10px;
                                padding: 10px;

                                Text {
                                    text: "ALL TOOLS CATALOG";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #0EA5E9;
                                }

                                // Category: Edit PDF
                                Rectangle {
                                    background: root.is_dark_mode ? #0F172A : #FFFFFF;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        Text { text: "EDIT PDF"; font-size: 10px; font-weight: 700; color: root.is_dark_mode ? #94A3B8 : #64748B; }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-e-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "✎ Edit Text & Typography"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-e-ta := TouchArea { clicked => { root.tool_changed("text"); } }
                                        }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-i-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "🖼 Insert / Replace Image"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-i-ta := TouchArea { clicked => { root.add_image_clicked(); } }
                                        }
                                    }
                                }

                                // Category: Forms & Signatures
                                Rectangle {
                                    background: root.is_dark_mode ? #0F172A : #FFFFFF;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        Text { text: "FORMS & SIGNATURES"; font-size: 10px; font-weight: 700; color: root.is_dark_mode ? #94A3B8 : #64748B; }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-f-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "☑ Interactive Form Fields"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-f-ta := TouchArea { clicked => { root.tool_changed("forms"); } }
                                        }
                                    }
                                }

                                // Category: Markup & Review
                                Rectangle {
                                    background: root.is_dark_mode ? #0F172A : #FFFFFF;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        Text { text: "REVIEW & ANNOTATIONS"; font-size: 10px; font-weight: 700; color: root.is_dark_mode ? #94A3B8 : #64748B; }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-h-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "✎ Text Highlight"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-h-ta := TouchArea { clicked => { root.add_annotation_clicked("Highlight"); } }
                                        }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-n-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "💬 FreeText Sticky Note"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-n-ta := TouchArea { clicked => { root.add_annotation_clicked("FreeText"); } }
                                        }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-s-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "▢ Geometric Box / Shape"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-s-ta := TouchArea { clicked => { root.add_annotation_clicked("Square"); } }
                                        }
                                    }
                                }

                                // Category: Convert & Export
                                Rectangle {
                                    background: root.is_dark_mode ? #0F172A : #FFFFFF;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        Text { text: "CONVERT & EXPORT"; font-size: 10px; font-weight: 700; color: root.is_dark_mode ? #94A3B8 : #64748B; }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: tc-x-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                                            HorizontalLayout { padding-left: 6px; spacing: 6px; alignment: center;
                                                Text { text: "💾 Clean Structural Export"; font-size: 11px; color: root.is_dark_mode ? #F8FAFC : #0F172A; vertical-alignment: center; }
                                            }
                                            tc-x-ta := TouchArea { clicked => { root.export_document_clicked(); } }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Bookmarks Mode
                        if root.left_rail_tab == "bookmarks" : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            padding: 12px;

                            Text {
                                text: "DOCUMENT OUTLINE";
                                font-size: 11px;
                                font-weight: 700;
                                color: #0EA5E9;
                            }

                            Rectangle {
                                background: root.is_dark_mode ? #0F172A : #FFFFFF;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.is_dark_mode ? #334155 : #E2E8F0;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: "• Document Root Section";
                                        font-size: 11px;
                                        color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                    }
                                    Text {
                                        text: "  └ Page 1: Overview";
                                        font-size: 11px;
                                        color: #0EA5E9;
                                    }
                                    if root.total_pages > 1 : Text {
                                        text: "  └ Page 2: Appendix";
                                        font-size: 11px;
                                        color: root.is_dark_mode ? #94A3B8 : #64748B;
                                    }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }
                        }

                        // Privacy Reassurance Card at bottom of left rail
                        Rectangle {
                            height: 60px;
                            background: root.is_dark_mode ? #0F172A : #F1F5F9;
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: "🛡️ 100% Local-First Processing";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #10B981;
                                }
                                Text {
                                    text: "Zero cloud upload • Pure Rust engine";
                                    font-size: 9px;
                                    color: root.is_dark_mode ? #94A3B8 : #64748B;
                                }
                            }
                        }
                    }
                }

                // Left panel separator
                Rectangle {
                    width: 1px;
                    background: root.is_dark_mode ? #334155 : #E2E8F0;
                }
            }

            // ----------------------------------------------------------------
            // 2B. CENTRAL PDF VIEWPORT (Main Document Canvas + Floating Quick Tools)
            // ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 1;
                background: root.is_dark_mode ? #0B1120 : #E2E8F0; // Neutral calm canvas
                clip: true; // Strict boundary clipping: prevents canvas bleeding over tabs/toolbars

                // Document Viewport ScrollView
                viewport_scroll := ScrollView {
                    width: 100%;
                    height: 100%;

                    Rectangle {
                        width: Math.max(viewport_scroll.width, canvas_paper.width + 48px);
                        height: Math.max(viewport_scroll.height, canvas_paper.height + 64px);

                        // Canvas Background click to clear selection
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.canvas_background_clicked();
                            }
                        }

                        // Centered Document Canvas
                        canvas_paper := Rectangle {
                            x: Math.max(24px, (parent.width - self.width) / 2);
                            y: Math.max(36px, (parent.height - self.height) / 2);
                            width: root.page_width * root.zoom_scale;
                            height: root.page_height * root.zoom_scale;
                            background: #FFFFFF; // Pure White Paper
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #CBD5E1;
                            drop-shadow-blur: 24px;

                            // Native Rasterized PDF Page Image (Retina 144 DPI)
                            if root.has_rendered_page_image : Image {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                source: root.rendered_page_image;
                                image-fit: fill;
                            }

                            // Prevent click passing through to clear selection
                            TouchArea {
                                clicked => {
                                    root.canvas_background_clicked();
                                }
                            }

                            // Extracted Form Fields, Annotations, and Image Elements
                            for elem in root.page_elements : Rectangle {
                                x: elem.x * root.zoom_scale;
                                y: elem.y * root.zoom_scale;
                                width: elem.width * root.zoom_scale;
                                height: elem.height * root.zoom_scale;
                                background: elem.is_selected ? (elem.kind == "annotation" ? #F59E0B22 : (elem.kind == "form_field" ? #3B82F622 : #0EA5E922)) : transparent;
                                border-width: elem.is_selected ? 2px : 0px;
                                border-color: elem.is_selected ? #0EA5E9 : transparent;
                                border-radius: 2px;

                                if elem.is_selected : Text {
                                    text: elem.label;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: elem.kind == "annotation" ? #D97706 : (elem.kind == "form_field" ? #2563EB : #0EA5E9);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        root.element_selected(elem.id);
                                    }
                                }
                            }

                            // Extracted Text Spans (Interactive selection hitboxes; text is rendered by native rasterizer)
                            for span in root.text_spans : Rectangle {
                                x: span.x * root.zoom_scale;
                                y: span.y * root.zoom_scale;
                                width: span.width * root.zoom_scale;
                                height: span.height * root.zoom_scale;
                                background: span.is_selected ? #0EA5E91A : transparent;
                                border-width: span.is_selected ? 1.5px : 0px;
                                border-color: #0EA5E9;
                                border-radius: 2px;

                                TouchArea {
                                    clicked => {
                                        root.span_selected(span.id);
                                    }
                                }
                            }

                            // In-Place Text Editing Field
                            if root.is_editing_text : Rectangle {
                                x: root.sel_x * root.zoom_scale;
                                y: root.sel_y * root.zoom_scale;
                                width: Math.max(root.sel_w * root.zoom_scale + 40px, 120px);
                                height: Math.max(root.sel_h * root.zoom_scale + 8px, 26px);
                                background: #FFFFFF;
                                border-width: 2px;
                                border-color: #0EA5E9;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    edit_input := TextInput {
                                        text: root.editing_text_buffer;
                                        font-size: 13px;
                                        color: #0F172A;
                                        vertical-alignment: center;
                                        edited => {
                                            root.editing_text_buffer = self.text;
                                        }
                                        accepted => {
                                            root.text_edit_committed(self.text);
                                        }
                                    }
                                }
                            }

                            // Selection Transform Handles Box
                            if root.has_selection && !root.is_editing_text : Rectangle {
                                x: root.sel_x * root.zoom_scale;
                                y: root.sel_y * root.zoom_scale;
                                width: root.sel_w * root.zoom_scale;
                                height: root.sel_h * root.zoom_scale;
                                border-width: 1.5px;
                                border-color: #0EA5E9;

                                // Canvas drag touch area across selection body
                                TouchArea {
                                    mouse-cursor: move;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.up) {
                                            if (Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px) {
                                                root.move_selected_clicked(((self.mouse-x - self.pressed-x) / 1px) / root.zoom_scale, ((self.mouse-y - self.pressed-y) / 1px) / root.zoom_scale);
                                            }
                                        }
                                    }
                                }

                                // 4 Corner Handles (7x7px white squares with primary accent border)
                                Rectangle { x: -4px; y: -4px; width: 8px; height: 8px; background: #FFFFFF; border-width: 1.5px; border-color: #0EA5E9; border-radius: 1px; }
                                Rectangle { x: parent.width - 4px; y: -4px; width: 8px; height: 8px; background: #FFFFFF; border-width: 1.5px; border-color: #0EA5E9; border-radius: 1px; }
                                Rectangle { x: -4px; y: parent.height - 4px; width: 8px; height: 8px; background: #FFFFFF; border-width: 1.5px; border-color: #0EA5E9; border-radius: 1px; }
                                Rectangle {
                                    x: parent.width - 5px;
                                    y: parent.height - 5px;
                                    width: 12px;
                                    height: 12px;
                                    background: #FFFFFF;
                                    border-width: 1.5px;
                                    border-color: #0EA5E9;
                                    border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: nwse-resize;
                                        clicked => {
                                            root.resize_selected_clicked(15.0, 15.0);
                                        }
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.up) {
                                                if (Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px) {
                                                    root.resize_selected_clicked(((self.mouse-x - self.pressed-x) / 1px) / root.zoom_scale, ((self.mouse-y - self.pressed-y) / 1px) / root.zoom_scale);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // Floating Acrobat Quick-Action Pill Toolbar (Docked at Top Center)
                // ------------------------------------------------------------
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 12px;
                    height: 38px;
                    border-radius: 19px;
                    background: root.is_dark_mode ? #1E293B : #FFFFFF;
                    border-width: 1px;
                    border-color: root.is_dark_mode ? #334155 : #CBD5E1;
                    drop-shadow-blur: 16px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        // Select Tool (Pointer)
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: root.active_tool == "select" ? #0EA5E9 : (ft-sel-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                            Text {
                                text: "↖";
                                font-size: 15px;
                                color: root.active_tool == "select" ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-sel-ta := TouchArea {
                                clicked => { root.tool_changed("select"); }
                            }
                        }

                        // Hand / Pan Tool
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: root.active_tool == "pan" ? #0EA5E9 : (ft-pan-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                            Text {
                                text: "✋";
                                font-size: 13px;
                                color: root.active_tool == "pan" ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-pan-ta := TouchArea {
                                clicked => { root.tool_changed("pan"); }
                            }
                        }

                        // Text Tool
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: root.active_tool == "text" ? #0EA5E9 : (ft-txt-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                            Text {
                                text: "T";
                                font-size: 14px;
                                font-weight: 700;
                                color: root.active_tool == "text" ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-txt-ta := TouchArea {
                                clicked => { root.tool_changed("text"); }
                            }
                        }

                        // Annotate Tool
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: root.active_tool == "annotate" ? #0EA5E9 : (ft-ann-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                            Text {
                                text: "✎";
                                font-size: 14px;
                                color: root.active_tool == "annotate" ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-ann-ta := TouchArea {
                                clicked => { root.tool_changed("annotate"); }
                            }
                        }

                        // Forms Tool
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: root.active_tool == "forms" ? #0EA5E9 : (ft-frm-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent);
                            Text {
                                text: "☑";
                                font-size: 14px;
                                color: root.active_tool == "forms" ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-frm-ta := TouchArea {
                                clicked => { root.tool_changed("forms"); }
                            }
                        }

                        // Add Image Button
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: ft-img-ta.has-hover ? (root.is_dark_mode ? #334155 : #F1F5F9) : transparent;
                            Text {
                                text: "🖼";
                                font-size: 13px;
                                color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ft-img-ta := TouchArea {
                                clicked => { root.add_image_clicked(); }
                            }
                        }

                        // Dynamic Contextual Actions in Floating Pill
                        if root.active_tool == "annotate" : Rectangle {
                            width: 1px;
                            height: 18px;
                            background: root.is_dark_mode ? #334155 : #CBD5E1;
                        }

                        if root.active_tool == "annotate" : Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: #F59E0B22;
                            border-width: 1px;
                            border-color: #F59E0B;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "+ Highlight"; font-size: 11px; font-weight: 600; color: #F59E0B; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.add_annotation_clicked("Highlight"); } }
                        }

                        if root.active_tool == "annotate" : Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: #0EA5E922;
                            border-width: 1px;
                            border-color: #0EA5E9;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "+ FreeText"; font-size: 11px; font-weight: 600; color: #0EA5E9; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.add_annotation_clicked("FreeText"); } }
                        }

                        if root.active_tool == "annotate" : Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: #10B98122;
                            border-width: 1px;
                            border-color: #10B981;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "+ Square"; font-size: 11px; font-weight: 600; color: #10B981; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.add_annotation_clicked("Square"); } }
                        }

                        // Delete Selected
                        if root.has_selection : Rectangle {
                            width: 1px;
                            height: 18px;
                            background: root.is_dark_mode ? #334155 : #CBD5E1;
                        }

                        if root.has_selection : Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: del-pill-ta.has-hover ? #EF4444 : #EF444422;
                            border-width: 1px;
                            border-color: #EF4444;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text { text: "🗑 Delete"; font-size: 11px; font-weight: 600; color: del-pill-ta.has-hover ? #FFFFFF : #EF4444; vertical-alignment: center; }
                            }
                            del-pill-ta := TouchArea { clicked => { root.delete_selected_clicked(); } }
                        }
                    }
                }
            }

            // ----------------------------------------------------------------
            // 2C. RIGHT CONTEXTUAL PROPERTIES PANEL (Acrobat-Class Inspector ~260px)
            // ----------------------------------------------------------------
            if root.right_panel_visible : HorizontalLayout {
                spacing: 0px;
                // Separator
                Rectangle {
                    width: 1px;
                    background: root.is_dark_mode ? #334155 : #E2E8F0;
                }

                Rectangle {
                    width: 260px;
                    background: root.is_dark_mode ? #1E293B : #F8FAFC;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;

                        // Panel Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "PROPERTIES";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.is_dark_mode ? #94A3B8 : #64748B;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 4px;
                                background: #0EA5E922;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: root.selection_type;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #0EA5E9;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Selection Properties Card
                        Rectangle {
                            background: root.is_dark_mode ? #0F172A : #FFFFFF;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                if root.has_selection : VerticalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: "Bounds: " + root.selection_bounds_text;
                                        font-size: 11px;
                                        color: root.is_dark_mode ? #CBD5E1 : #64748B;
                                    }

                                    // 1. Text Selection Properties
                                    if root.selection_type == "Text" : VerticalLayout {
                                        spacing: 6px;
                                        if root.selection_font_name != "" : Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.is_dark_mode ? #1E293B : #F1F5F9;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "🔤 " + root.selection_font_name + " • " + root.selection_font_size;
                                                    font-size: 11px;
                                                    color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if root.selection_is_editable : VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Content:";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: root.is_dark_mode ? #94A3B8 : #64748B;
                                            }
                                            Rectangle {
                                                background: root.is_dark_mode ? #1E293B : #F8FAFC;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.is_dark_mode ? #475569 : #CBD5E1;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    prop_input := TextInput {
                                                        text: root.selection_text_content;
                                                        font-size: 12px;
                                                        color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                                        vertical-alignment: center;
                                                        edited => {
                                                            root.property_text_edited(self.text);
                                                        }
                                                        accepted => {
                                                            root.text_edit_committed(self.text);
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: apply-ta.has-hover ? #0284C7 : #0EA5E9;
                                                Text {
                                                    text: "Apply Edit";
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                apply-ta := TouchArea {
                                                    clicked => {
                                                        root.text_edit_committed(prop_input.text);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 2. Form Field Selection Properties
                                    if root.selection_type == "FormField" : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Field: " + root.form_field_name;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #0284C7;
                                        }
                                        Text {
                                            text: "Type: " + root.form_field_type;
                                            font-size: 10px;
                                            color: root.is_dark_mode ? #94A3B8 : #64748B;
                                        }

                                        if root.form_field_type == "Checkbox" || root.form_field_type == "RadioButtonGroup" : Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: root.form_field_checked ? #10B981 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                            Text {
                                                text: root.form_field_checked ? "☑ Checked" : "☐ Unchecked";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: root.form_field_checked ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            ff-cb-ta := TouchArea {
                                                clicked => {
                                                    root.form_field_toggled(root.form_field_name, root.form_field_checked ? "false" : "true");
                                                }
                                            }
                                        }

                                        if root.form_field_type == "Text" || root.form_field_type == "Choice" : VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Value:";
                                                font-size: 11px;
                                                color: root.is_dark_mode ? #94A3B8 : #64748B;
                                            }
                                            Rectangle {
                                                background: root.is_dark_mode ? #1E293B : #F8FAFC;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.is_dark_mode ? #475569 : #CBD5E1;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    ff_input := TextInput {
                                                        text: root.form_field_value;
                                                        font-size: 12px;
                                                        color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                                        vertical-alignment: center;
                                                        edited => {
                                                            root.property_text_edited(self.text);
                                                        }
                                                        accepted => {
                                                            root.form_field_text_committed(root.form_field_name, self.text);
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: ff-apply-ta.has-hover ? #0284C7 : #0EA5E9;
                                                Text {
                                                    text: "Apply Field Value";
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                ff-apply-ta := TouchArea {
                                                    clicked => {
                                                        root.form_field_text_committed(root.form_field_name, ff_input.text);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 3. Annotation Selection Properties
                                    if root.selection_type == "Annotation" : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Subtype: " + root.annotation_subtype;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #F59E0B;
                                        }
                                        Text {
                                            text: "Note / Content:";
                                            font-size: 11px;
                                            color: root.is_dark_mode ? #94A3B8 : #64748B;
                                        }
                                        Rectangle {
                                            background: root.is_dark_mode ? #1E293B : #F8FAFC;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: root.is_dark_mode ? #475569 : #CBD5E1;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                an_input := TextInput {
                                                    text: root.selection_text_content;
                                                    font-size: 12px;
                                                    color: root.is_dark_mode ? #F8FAFC : #0F172A;
                                                    vertical-alignment: center;
                                                    edited => {
                                                        root.property_text_edited(self.text);
                                                    }
                                                    accepted => {
                                                        root.update_annotation_text_clicked(self.text);
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: an-apply-ta.has-hover ? #D97706 : #F59E0B;
                                            Text {
                                                text: "Update Annotation Text";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #FFFFFF;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            an-apply-ta := TouchArea {
                                                clicked => {
                                                    root.update_annotation_text_clicked(an_input.text);
                                                }
                                            }
                                        }
                                    }

                                    // 4. Image Selection Properties
                                    if root.selection_type == "Image" : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Image Ref: " + root.selection_node_id;
                                            font-size: 11px;
                                            color: root.is_dark_mode ? #CBD5E1 : #64748B;
                                        }
                                        Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: rep-img-ta.has-hover ? #0284C7 : #0EA5E9;
                                            Text {
                                                text: "🖼 Replace Image...";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #FFFFFF;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            rep-img-ta := TouchArea {
                                                clicked => {
                                                    root.replace_image_clicked();
                                                }
                                            }
                                        }
                                    }

                                    // 5. Transform & Position Controls
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: "Position & Size:";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.is_dark_mode ? #94A3B8 : #64748B;
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: mv-l-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "◀"; font-size: 10px; color: mv-l-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                mv-l-ta := TouchArea { clicked => { root.move_selected_clicked(-10.0, 0.0); } }
                                            }
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: mv-r-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "▶"; font-size: 10px; color: mv-r-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                mv-r-ta := TouchArea { clicked => { root.move_selected_clicked(10.0, 0.0); } }
                                            }
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: mv-u-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "▲"; font-size: 10px; color: mv-u-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                mv-u-ta := TouchArea { clicked => { root.move_selected_clicked(0.0, -10.0); } }
                                            }
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: mv-d-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "▼"; font-size: 10px; color: mv-d-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                mv-d-ta := TouchArea { clicked => { root.move_selected_clicked(0.0, 10.0); } }
                                            }
                                        }
                                        if root.selection_type == "Annotation" || root.selection_type == "Image" : HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: exp-sz-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "＋ Expand"; font-size: 10px; color: exp-sz-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                exp-sz-ta := TouchArea { clicked => { root.resize_selected_clicked(15.0, 15.0); } }
                                            }
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 4px;
                                                background: shr-sz-ta.has-hover ? #0284C7 : (root.is_dark_mode ? #334155 : #E2E8F0);
                                                Text { text: "－ Shrink"; font-size: 10px; color: shr-sz-ta.has-hover ? #FFFFFF : (root.is_dark_mode ? #F8FAFC : #0F172A); horizontal-alignment: center; vertical-alignment: center; }
                                                shr-sz-ta := TouchArea { clicked => { root.resize_selected_clicked(-15.0, -15.0); } }
                                            }
                                        }
                                    }

                                    // Universal Delete Button
                                    Rectangle {
                                        height: 26px;
                                        border-radius: 4px;
                                        background: del-prop-ta.has-hover ? #DC2626 : #EF444422;
                                        border-width: 1px;
                                        border-color: #EF4444;
                                        Text {
                                            text: "🗑 Delete Selected";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: del-prop-ta.has-hover ? #FFFFFF : #EF4444;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        del-prop-ta := TouchArea {
                                            clicked => {
                                                root.delete_selected_clicked();
                                            }
                                        }
                                    }
                                }

                                if !root.has_selection : Text {
                                    text: "Select any text, image, form field, or annotation on canvas to inspect and edit its properties.";
                                    font-size: 11px;
                                    color: root.is_dark_mode ? #64748B : #94A3B8;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Integrity & Evidence Card
                        Rectangle {
                            background: root.is_dark_mode ? #0F172A : #FFFFFF;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text {
                                    text: "INTEGRITY & SECURITY";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: root.is_dark_mode ? #94A3B8 : #64748B;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Evidence:";
                                        font-size: 11px;
                                        color: root.is_dark_mode ? #CBD5E1 : #334155;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 18px;
                                        background: #10B98122;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: root.evidence_level;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #10B981; // Emerald
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: root.security_status;
                                    font-size: 10px;
                                    color: root.is_dark_mode ? #64748B : #94A3B8;
                                }
                            }
                        }

                        // History Stack Depth Card
                        Rectangle {
                            background: root.is_dark_mode ? #0F172A : #FFFFFF;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.is_dark_mode ? #334155 : #E2E8F0;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "HISTORY STACK";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: root.is_dark_mode ? #94A3B8 : #64748B;
                                }
                                Text {
                                    text: "Undo Depth: " + root.undo_depth;
                                    font-size: 11px;
                                    color: root.is_dark_mode ? #CBD5E1 : #334155;
                                }
                                Text {
                                    text: "Redo Depth: " + root.redo_depth;
                                    font-size: 11px;
                                    color: root.is_dark_mode ? #CBD5E1 : #334155;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // Divider above bottom status bar
        Rectangle {
            height: 1px;
            background: root.is_dark_mode ? #334155 : #E2E8F0;
        }

        // ====================================================================
        // 3. BOTTOM STATUS BAR (Acrobat-Class Page Navigation, Zoom, Security)
        // ====================================================================
        Rectangle {
            height: 30px;
            background: root.is_dark_mode ? #0F172A : #FFFFFF;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: center;

                // Page Navigation: Prev / Next
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: 4px;
                        background: p-prev-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        Text {
                            text: "◀";
                            font-size: 10px;
                            color: root.is_dark_mode ? #CBD5E1 : #334155;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        p-prev-ta := TouchArea {
                            clicked => { root.prev_page_clicked(); }
                        }
                    }

                    Text {
                        text: root.page_info_text;
                        font-size: 11px;
                        font-weight: 600;
                        color: root.is_dark_mode ? #F8FAFC : #0F172A;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: 4px;
                        background: p-next-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        Text {
                            text: "▶";
                            font-size: 10px;
                            color: root.is_dark_mode ? #CBD5E1 : #334155;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        p-next-ta := TouchArea {
                            clicked => { root.next_page_clicked(); }
                        }
                    }
                }

                Rectangle { width: 1px; height: 16px; background: root.is_dark_mode ? #334155 : #E2E8F0; }

                // Zoom Controls
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: 4px;
                        background: zm-out-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        Text {
                            text: "−";
                            font-size: 15px;
                            color: root.is_dark_mode ? #CBD5E1 : #334155;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        zm-out-ta := TouchArea {
                            clicked => { root.zoom_out_clicked(); }
                        }
                    }

                    Text {
                        text: root.zoom_percent + "%";
                        font-size: 11px;
                        font-weight: 600;
                        color: root.is_dark_mode ? #F8FAFC : #0F172A;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: 4px;
                        background: zm-in-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        Text {
                            text: "+";
                            font-size: 15px;
                            color: root.is_dark_mode ? #CBD5E1 : #334155;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        zm-in-ta := TouchArea {
                            clicked => { root.zoom_in_clicked(); }
                        }
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: fit-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "⛶ Fit Page";
                                font-size: 11px;
                                font-weight: 500;
                                color: root.is_dark_mode ? #94A3B8 : #64748B;
                                vertical-alignment: center;
                            }
                        }
                        fit-ta := TouchArea {
                            clicked => { root.zoom_reset_clicked(); }
                        }
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: fit-w-ta.has-hover ? (root.is_dark_mode ? #334155 : #E2E8F0) : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "↔ Fit Width";
                                font-size: 11px;
                                font-weight: 500;
                                color: root.is_dark_mode ? #94A3B8 : #64748B;
                                vertical-alignment: center;
                            }
                        }
                        fit-w-ta := TouchArea {
                            clicked => { root.fit_width_clicked(); }
                        }
                    }
                }

                Rectangle { width: 1px; height: 16px; background: root.is_dark_mode ? #334155 : #E2E8F0; }

                // Status message
                Text {
                    text: root.status_message;
                    font-size: 11px;
                    color: root.is_dark_mode ? #64748B : #94A3B8;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Evidence Level Tag
                Rectangle {
                    height: 18px;
                    background: #10B98122;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: "●";
                            font-size: 8px;
                            color: #10B981;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.evidence_level;
                            font-size: 10px;
                            font-weight: 700;
                            color: #10B981;
                            vertical-alignment: center;
                        }
                    }
                }

                // Privacy Reassurance Badge
                Rectangle {
                    height: 20px;
                    background: root.is_dark_mode ? #1E293B : #F1F5F9;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.is_dark_mode ? #334155 : #CBD5E1;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: "🛡️ Local-First / Private";
                            font-size: 10px;
                            font-weight: 600;
                            color: root.is_dark_mode ? #CBD5E1 : #334155;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
